        <!-- Page 11: 總名單 (需求2: 新增年齡，分開「知」複選框與「星星」評分) -->
        <div class="page">
            <div class="card">
                <div class="card-title">總名單紀錄</div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>姓名</th>
                                <th>性別/婚姻/子女</th>
                                <th>年齡</th>
                                <th>工作/需求</th>
                                <th style="text-align:center; width:45px;">知</th>
                                <th>星星等級</th>
                            </tr>
                        </thead>
                        <tbody id="totalListBody">
                            <!-- JS generated -->
                        </tbody>
                    </table>
                </div>
                <button class="btn" style="margin-top:10px;" onclick="addTotalListRow()">新增名單</button>
            </div>
        </div>

        <!-- Page 12: 百戰表 (需求3: 自定義標題 & 4頁切換) -->
        <div class="page">
            <div class="card">
                <div class="card-title">百戰表</div>
                
                <!-- 4頁切換子頁籤 -->
                <div class="sub-tab-container">
                    <div class="sub-tab active" onclick="switchBattlePage(0)">第一頁</div>
                    <div class="sub-tab" onclick="switchBattlePage(1)">第二頁</div>
                    <div class="sub-tab" onclick="switchBattlePage(2)">第三頁</div>
                    <div class="sub-tab" onclick="switchBattlePage(3)">第四頁</div>
                </div>

                <!-- 每一頁可自定義標題 -->
                <label style="font-size: 0.85rem; font-weight: 600;">自定義本頁主題 ( )：</label>
                <input type="text" id="battle_title_custom" placeholder="例如：零售百戰表 / 推薦百戰表 / 幸福餐分享" oninput="saveCurrentBattleTitle()">

                <p style="font-size: 0.8rem; text-align: center; margin: 10px 0; color: var(--text-sub);">
                    沒有付諸執行的願景，僅是口號，唯有瞄準目標持續向前行！
                </p>
                
                <div class="grid-10" id="battleGrid">
                    <!-- JS Dynamic Grid -->
                </div>
            </div>
        </div>

        <!-- Page 13: 組織網路圖 -->
        <div class="page">
            <div class="card">
                <div class="card-title">組織網路圖</div>
                <textarea id="orgNetworkData" rows="12" placeholder="在此記錄組織結構、部門佈局與核心夥伴..."></textarea>
            </div>
        </div>

        <!-- Page 14: 月曆行程 -->
        <div class="page">
            <div class="card">
                <div class="card-title">月度行程規劃</div>
                <div style="display:flex; gap:10px; margin-bottom:10px;">
                    <input type="text" id="cal_year" placeholder="年">
                    <input type="text" id="cal_month" placeholder="月">
                </div>
                <textarea id="calendar_notes" rows="10" placeholder="填寫本月日曆重要行程與每日跳時不跳日規劃..."></textarea>
            </div>
        </div>

        <!-- Page 15: 月工作重點 / 重要會議 -->
        <div class="page">
            <div class="card">
                <div class="card-title">( ) 月工作重點</div>
                <input type="text" id="m_target_bv" placeholder="目標 BV">
                <input type="text" id="m_target_rec" placeholder="推薦 人">
                <input type="text" id="m_target_session" placeholder="場次 場">
                <textarea id="m_target_other" rows="3" placeholder="其他重點"></textarea>
            </div>
            <div class="card">
                <div class="card-title">重要活動 / 會議邀約</div>
                <textarea id="m_meetings" rows="6" placeholder="列出本月100%相信會議、創業論壇、LRC、BTC等邀約名單與時間..."></textarea>
            </div>
        </div>

        <!-- Page 16: 跟進表 -->
        <div class="page">
            <div class="card">
                <div class="card-title">個人跟進表</div>
                <input type="text" id="follow_name" placeholder="姓名">
                <input type="text" id="follow_info" placeholder="性別 / 生日 / 歲數 / 星座">
                <input type="text" id="follow_job" placeholder="工作 / 家庭">
                <textarea id="follow_interest" rows="2" placeholder="興趣 / 重要訊息"></textarea>
                <textarea id="follow_history" rows="6" placeholder="記錄跟進日期、工作內容、音頻/書籍、下一次工作重點..."></textarea>
            </div>
        </div>

        <!-- Page 17: 勝利圈四大主線圖 -->
        <div class="page">
            <div class="card">
                <div class="card-title">勝利圈 - 四大主線圖</div>
                <div class="text-content" style="font-size:0.85rem;">
                    <p><strong>五星領導人標準：</strong></p>
                    <p>S1 : 100%產品愛用者</p>
                    <p>S2 : 態度→肯學習、願意配合、強烈的成功欲望</p>
                    <p>S3 : 3S 行動→銷售、推薦、服務</p>
                    <p>S4 : 承諾→肯投資、每會必到</p>
                    <p>S5 : 領導力→肯承擔、目標明確(符合12%)</p>
                </div>
                <textarea id="victory_wheel_notes" rows="8" placeholder="記錄 4 大主線的核心夥伴發展狀態..."></textarea>
            </div>
        </div>

        <!-- Page 18: 年度行事曆 -->
        <div class="page">
            <div class="card">
                <div class="card-title">年度行事曆 (1月 ~ 12月)</div>
                <textarea id="annual_calendar" rows="12" placeholder="填寫 1~12 月全年度重要大會、海外旅遊、表揚大會預定行程..."></textarea>
            </div>
        </div>

    </div>

    <!-- Bottom Bar -->
    <div class="bottom-bar">
        <button class="btn btn-outline" onclick="exportData()">匯出備份</button>
        <button class="btn" onclick="saveData()">儲存進度</button>
    </div>

    <script>
        let currentBattlePageIndex = 0;

        // Switch Page
        function switchPage(index) {
            const pages = document.querySelectorAll('.page');
            const tabs = document.querySelectorAll('.nav-tab');
            pages.forEach((p, i) => p.classList.toggle('active', i === index));
            tabs.forEach((t, i) => t.classList.toggle('active', i === index));
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Dynamic Elements Generator
        function initFormElements() {
            // Ideal List Page 3
            const idealBody = document.getElementById('idealListBody');
            idealBody.innerHTML = '';
            for (let i = 1; i <= 10; i++) {
                idealBody.innerHTML += `
                    <tr>
                        <td>${i}</td>
                        <td><input type="text" id="ideal_item_${i}"></td>
                        <td><input type="text" id="ideal_cost_${i}"></td>
                        <td><input type="text" id="ideal_date_${i}"></td>
                        <td><input type="text" id="ideal_desc_${i}"></td>
                    </tr>
                `;
            }

            // Regret List Page 4
            const regretContainer = document.getElementById('regretListContainer');
            regretContainer.innerHTML = '';
            for (let i = 1; i <= 3; i++) {
                regretContainer.innerHTML += `
                    <div style="border:1px solid var(--border-color); padding:8px; border-radius:8px; margin-bottom:8px;">
                        <strong>#${i} 哪件事：</strong><input type="text" id="regret_what_${i}">
                        <p>為什麼選這個？</p><input type="text" id="regret_why_choose_${i}">
                        <p>為什麼很重要？</p><input type="text" id="regret_why_important_${i}">
                        <p>沒完成會怎樣？</p><input type="text" id="regret_if_not_${i}">
                    </div>
                `;
            }

            // Annual Target Page 6
            const targets = ['12%', '15%銅章', '21%', '白金', '翡翠', '鑽石'];
            const targetBody = document.getElementById('annualTargetBody');
            targetBody.innerHTML = '';
            targets.forEach((t, idx) => {
                targetBody.innerHTML += `
                    <tr>
                        <td><strong>${t}</strong></td>
                        <td><input type="text" id="target_est_${idx}"></td>
                        <td><input type="text" id="target_act_${idx}"></td>
                    </tr>
                `;
            });

            // Tianlong System Setup
            setupTianlong();

            // 1. 曼陀羅 Setup (3x3 陣列 = 9個九宮格)
            setupMandala3x3();

            // 2. 總名單 Initial Rows
            const totalListBody = document.getElementById('totalListBody');
            totalListBody.innerHTML = '';
            for (let i = 1; i <= 5; i++) { addTotalListRow(); }

            // 3. 百戰表 Setup (4頁機制)
            renderBattleGrid(0);
        }

        // 需求1: 建立 3x3 的大曼陀羅陣列 (九個九宮格)
        function setupMandala3x3() {
            const superGrid = document.getElementById('mandalaSuperGrid');
            superGrid.innerHTML = '';

            for (let block = 1; block <= 9; block++) {
                const isCenterBlock = (block === 5);
                let cellsHtml = '';

                for (let cell = 1; cell <= 9; cell++) {
                    const isCoreCell = (cell === 5);
                    let placeholder = '';
                    if (isCenterBlock && isCoreCell) placeholder = '核心';
                    else if (isCoreCell) placeholder = `子核${block}`;
                    else placeholder = `${cell}`;

                    cellsHtml += `
                        <div class="mandala-cell ${isCoreCell ? 'core-cell' : ''}">
                            <input type="text" id="mandala_b${block}_c${cell}" placeholder="${placeholder}">
                        </div>
                    `;
                }

                superGrid.innerHTML += `
                    <div class="mandala-block ${isCenterBlock ? 'center-block' : ''}">
                        <div class="mandala-grid">
                            ${cellsHtml}
                        </div>
                    </div>
                `;
            }
        }

        // 需求2: 總名單新增年齡，並將「知」複選框與「星星等級」分開
        function addTotalListRow() {
            const totalListBody = document.getElementById('totalListBody');
            const rowCount = totalListBody.children.length + 1;
            totalListBody.innerHTML += `
                <tr>
                    <td><input type="text" id="tot_name_${rowCount}"></td>
                    <td><input type="text" id="tot_info_${rowCount}"></td>
                    <td><input type="text" id="tot_age_${rowCount}" style="width:50px;"></td>
                    <td><input type="text" id="tot_job_${rowCount}"></td>
                    <td style="text-align:center;"><input type="checkbox" id="tot_know_${rowCount}" style="transform:scale(1.2);"></td>
                    <td>
                        <select id="tot_star_${rowCount}">
                            <option value="">請選擇</option>
                            <option value="★">★</option>
                            <option value="★★">★★</option>
                            <option value="★★★">★★★</option>
                            <option value="★★★★">★★★★</option>
                            <option value="★★★★★">★★★★★</option>
                        </select>
                    </td>
                </tr>
            `;
        }

        // 需求3: 百戰表4頁切換與自定義標題
        function switchBattlePage(pageIdx) {
            currentBattlePageIndex = pageIdx;
            const subTabs = document.querySelectorAll('.sub-tab');
            subTabs.forEach((tab, i) => tab.classList.toggle('active', i === pageIdx));
            
            // 讀取當前頁面標題
            const titleInput = document.getElementById('battle_title_custom');
            const savedTitle = localStorage.getItem(`battle_title_p${pageIdx}`) || '';
            titleInput.value = savedTitle;

            // 渲染百戰表內容
            renderBattleGrid(pageIdx);
        }

        function saveCurrentBattleTitle() {
            const titleInput = document.getElementById('battle_title_custom');
            localStorage.setItem(`battle_title_p${currentBattlePageIndex}`, titleInput.value);
        }

        function renderBattleGrid(pageIdx) {
            const battleGrid = document.getElementById('battleGrid');
            battleGrid.innerHTML = '';
            const rawData = localStorage.getItem('peak_blueprint_data');
            const data = rawData ? JSON.parse(rawData) : {};

            for (let i = 1; i <= 100; i++) {
                const elementId = `battle_p${pageIdx}_${i}`;
                const savedVal = data[elementId] || '';
                battleGrid.innerHTML += `
                    <div class="grid-box">
                        <span style="font-size:0.7rem; color:var(--text-sub);">${i}</span>
                        <input type="text" id="${elementId}" value="${savedVal}">
                    </div>
                `;
            }
        }

        function setupTianlong() {
            const t1 = ["參觀安麗公司/生活體驗館", "了解獎金分配制度", "閱讀營業守則", "了解小產品示範5-10樣", "了解『幸福餐』", "了解『益之源淨水器』示範", "來參與3-5次課程環境"];
            renderChecklist('tianlong1', t1, 'tl1');

            const t2 = ["你決定開始安麗事業了嗎？", "你真正想做安麗的理由？", "準備你的『為何做安麗』並與上手教練分享", "認知安麗的成功是自己的責任"];
            renderChecklist('tianlong2', t2, 'tl2');

            const t3 = ["報名《BTC》增進產品知識", "使用新人優惠", "使用20樣以上生活必需消耗品", "下載AM卡操作，綁定Line"];
            renderChecklist('tianlong3', t3, 'tl3');

            const t4 = ["曼陀羅列名單，與上手白金討論", "購買生財工具(產品示範箱)", "學會20種+1+1以上的產品示範", "購買金三角入口會議門票"];
            renderChecklist('tianlong4', t4, 'tl4');

            const t5 = ["定位發展主力產品", "學跟做沒有落差，邊學邊做", "認真體驗產品，自己就是代言人", "學會建立第一個顧客"];
            renderChecklist('tianlong5', t5, 'tl5');

            const t6 = ["心態：每個人都需要這個機會", "開始落實紀錄：《百戰表》以量取勝", "學會探問需求，了解對象潛在改變動機", "鍛鍊自己講OPP"];
            renderChecklist('tianlong6', t6, 'tl6');

            const t7 = ["落實《成功藍圖》，往下深十代找出潛力領導人", "協助『潛在領導人』依序完成以上六大步驟", "提升領導力、專業能力、解決問題的能力"];
            renderChecklist('tianlong7', t7, 'tl7');

            const t8 = ["培養自己成為5星領導人並以身作則", "成為5星領導人：100%產品愛用者、態度星、承諾星、3S行動星、領導星", "畫《勝利圈》找到合格骨幹"];
            renderChecklist('tianlong8', t8, 'tl8');
        }

        function renderChecklist(containerId, items, prefix) {
            const c = document.getElementById(containerId);
            c.innerHTML = items.map((item, idx) => `
                <div class="checkbox-group">
                    <input type="checkbox" id="${prefix}_ck_${idx}">
                    <label for="${prefix}_ck_${idx}">${item}</label>
                </div>
            `).join('');
        }

        // Save & Load LocalStorage
        function saveData() {
            const inputs = document.querySelectorAll('input, textarea, select');
            const data = JSON.parse(localStorage.getItem('peak_blueprint_data') || '{}');
            
            inputs.forEach(el => {
                if (el.id) {
                    if (el.type === 'checkbox') {
                        data[el.id] = el.checked;
                    } else {
                        data[el.id] = el.value;
                    }
                }
            });

            localStorage.setItem('peak_blueprint_data', JSON.stringify(data));
            alert('所有藍圖進度已成功儲存！');
        }

        function loadData() {
            const raw = localStorage.getItem('peak_blueprint_data');
            if (!raw) return;
            const data = JSON.parse(raw);
            
            // 若總名單列數超出預設，自動動態擴充
            let maxTotalListRow = 5;
            Object.keys(data).forEach(id => {
                if (id.startsWith('tot_name_')) {
                    const rowNum = parseInt(id.replace('tot_name_', ''));
                    if (rowNum > maxTotalListRow) maxTotalListRow = rowNum;
                }
            });
            const currentRows = document.getElementById('totalListBody').children.length;
            for (let i = currentRows + 1; i <= maxTotalListRow; i++) {
                addTotalListRow();
            }

            // 填入所有元素值
            Object.keys(data).forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    if (el.type === 'checkbox') {
                        el.checked = data[id];
                    } else {
                        el.value = data[id];
                    }
                }
            });

            // 載入百戰表第一頁標題
            const titleInput = document.getElementById('battle_title_custom');
            if (titleInput) {
                titleInput.value = localStorage.getItem('battle_title_p0') || '';
            }
        }

        function exportData() {
            const raw = localStorage.getItem('peak_blueprint_data');
            if (!raw) {
                alert('尚無可匯出的資料！');
                return;
            }
            const blob = new Blob([raw], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `成功藍圖備份_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
        }

        // Initialization
        window.onload = function() {
            initFormElements();
            loadData();
        };
    </script>
</body>
</html>
